From 03febb0eb235ae87e086d156ba7512ff0187ee4f Mon Sep 17 00:00:00 2001
From: Krzysztof Chojnowski <krzysztof.chojnowski@somlabs.com>
Date: Wed, 18 Dec 2024 11:42:01 +0100
Subject: [PATCH] SOMLABS: add swap p/n and enable burst mode in
 lontium-lt8912b driver

---
 arch/arm/configs/multi_v7_defconfig      |  1 +
 drivers/gpu/drm/bridge/lontium-lt8912b.c | 28 +++++++++++++++++++++++-
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/arch/arm/configs/multi_v7_defconfig b/arch/arm/configs/multi_v7_defconfig
index ff3a00b32..460f292e4 100644
--- a/arch/arm/configs/multi_v7_defconfig
+++ b/arch/arm/configs/multi_v7_defconfig
@@ -709,6 +709,7 @@ CONFIG_DRM_EXYNOS_MIXER=y
 CONFIG_DRM_EXYNOS_DPI=y
 CONFIG_DRM_EXYNOS_DSI=y
 CONFIG_DRM_EXYNOS_HDMI=y
+CONFIG_DRM_LONTIUM_LT8912B=y
 CONFIG_DRM_ROCKCHIP=m
 CONFIG_ROCKCHIP_ANALOGIX_DP=y
 CONFIG_ROCKCHIP_DW_HDMI=y
diff --git a/drivers/gpu/drm/bridge/lontium-lt8912b.c b/drivers/gpu/drm/bridge/lontium-lt8912b.c
index 0efcbc73f..51fe8dac0 100644
--- a/drivers/gpu/drm/bridge/lontium-lt8912b.c
+++ b/drivers/gpu/drm/bridge/lontium-lt8912b.c
@@ -45,10 +45,13 @@ struct lt8912 {
 
 	u8 data_lanes;
 	bool is_power_on;
+	bool swap_mipi_pn;
 };
 
 static int lt8912_write_init_config(struct lt8912 *lt)
 {
+	int ret;
+
 	const struct reg_sequence seq[] = {
 		/* Digital clock en*/
 		{0x08, 0xff},
@@ -76,7 +79,13 @@ static int lt8912_write_init_config(struct lt8912 *lt)
 		{0x55, 0x44},
 		{0x57, 0x01},
 		{0x5a, 0x02},
+	};
+
+	ret = regmap_multi_reg_write(lt->regmap[I2C_MAIN], seq, ARRAY_SIZE(seq));
+	if (ret < 0)
+		return ret;
 
+	const struct reg_sequence seq_mipi_analog[] = {
 		/*MIPI Analog*/
 		{0x3e, 0xd6},
 		{0x3f, 0xd4},
@@ -84,7 +93,21 @@ static int lt8912_write_init_config(struct lt8912 *lt)
 		{0xB2, 0x00},
 	};
 
-	return regmap_multi_reg_write(lt->regmap[I2C_MAIN], seq, ARRAY_SIZE(seq));
+        const struct reg_sequence seq_mipi_analog_swapped[] = {
+                {0x3e, 0xf6}, /* Swap P/N mipi lines */
+                {0x3f, 0xd4},
+                {0x41, 0x3c},
+                {0xB2, 0x00},
+        };
+
+	if (lt->swap_mipi_pn)
+		return regmap_multi_reg_write(lt->regmap[I2C_MAIN],
+					      seq_mipi_analog_swapped,
+					      ARRAY_SIZE(seq_mipi_analog_swapped));
+	else
+		return regmap_multi_reg_write(lt->regmap[I2C_MAIN],
+					      seq_mipi_analog,
+					      ARRAY_SIZE(seq_mipi_analog));
 }
 
 static int lt8912_write_mipi_basic_config(struct lt8912 *lt)
@@ -499,6 +522,7 @@ static int lt8912_attach_dsi(struct lt8912 *lt)
 	dsi->format = MIPI_DSI_FMT_RGB888;
 
 	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+                          MIPI_DSI_MODE_VIDEO_BURST |
 			  MIPI_DSI_MODE_LPM |
 			  MIPI_DSI_MODE_NO_EOT_PACKET;
 
@@ -655,6 +679,8 @@ static int lt8912_parse_dt(struct lt8912 *lt)
 
 	lt->data_lanes = data_lanes;
 
+	lt->swap_mipi_pn = of_property_read_bool(dev->of_node, "swap-mipi-pn");
+
 	lt->host_node = of_graph_get_remote_node(dev->of_node, 0, -1);
 	if (!lt->host_node) {
 		dev_err(lt->dev, "%s: Failed to get remote port\n", __func__);
